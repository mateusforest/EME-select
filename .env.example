# Apenas variáveis do servidor. Nunca use VITE_ em credenciais privadas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# O M reutiliza a conexão da Central de IA. Modelo opcional exclusivo do chat público.
# OPENAI_CHAT_MODEL=
# EME_PUBLIC_CHAT_ENABLED=false desliga somente a conversa pública.

# WhatsApp Cloud API: preencher somente ao configurar o aplicativo da EME.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Versão suportada exibida no painel/documentação da Meta, no formato vNN.0.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_EXPECTED_NUMBER=5554991578029
# Habilitar somente após aplicar 20260916_whatsapp.sql e conferir a conta.
WHATSAPP_WEBHOOK_ENABLED=false

# Produção local de cenários: não usar VITE_, não é necessária no frontend/Vercel.
WORLDLABS_API_KEY=

# M Switch: todos os dados sensíveis ficam no servidor.
# Gere SWITCH_INVITE_SECRET aleatório com >=32 caracteres e preserve-o
# até expirarem convites anteriores. Permite tokens HMAC de convites e opt-out.
SWITCH_INVITE_SECRET=
# A Meta exige modelo aprovado. Corpo do modelo: {{1}} cidade, {{2}} link de
# condições comerciais e {{3}} link para parar alertas. Usar linguagem pt_BR.
SWITCH_WHATSAPP_TEMPLATE=
# Padrão bloqueado: só ativar depois de checar conexão, template e consentimento.
SWITCH_WHATSAPP_ENABLED=false
# Chave aleatória >=20 caracteres. Vercel a envia em Authorization: Bearer.
CRON_SECRET=
