# Apenas variáveis do servidor. Nunca use VITE_ em credenciais privadas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# O M reutiliza a conexão da Central de IA. Modelo opcional exclusivo do chat público.
# OPENAI_CHAT_MODEL=
# EME_PUBLIC_CHAT_ENABLED=false desliga somente a conversa pública.

# WhatsApp Cloud API: preencher somente ao configurar o aplicativo da EME.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Versão suportada exibida no painel/documentação da Meta, no formato vNN.0.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_EXPECTED_NUMBER=5554991578029
# Habilitar somente após aplicar 20260916_whatsapp.sql e conferir a conta.
WHATSAPP_WEBHOOK_ENABLED=false

# Produção local de cenários: não usar VITE_, não é necessária no frontend/Vercel.
WORLDLABS_API_KEY=

# M Switch: todos os dados sensíveis ficam no servidor.
# Gere SWITCH_INVITE_SECRET aleatório com >=32 caracteres e preserve-o
# até expirarem convites anteriores. Permite tokens HMAC de convites e opt-out.
SWITCH_INVITE_SECRET=
# A Meta exige modelo aprovado. Corpo do modelo: {{1}} cidade, {{2}} link de
# condições comerciais e {{3}} link para parar alertas. Usar linguagem pt_BR.
SWITCH_WHATSAPP_TEMPLATE=
# Padrão bloqueado: só ativar depois de checar conexão, template e consentimento.
SWITCH_WHATSAPP_ENABLED=false
# Chave aleatória >=20 caracteres. Vercel a envia em Authorization: Bearer.
CRON_SECRET=

# Autopiloto comercial (desativado por padrão).
# Apenas compradores/investidores qualificados, estoque autorizado atualizado
# há <= 7 dias e profissionais verificados com opt-in poderão receber teaser.
# Valores de exemplo NÃO são contratos nem autorização de corretagem. Necessária
# definição comercial/jurídica antes de ativar.
SWITCH_AUTOPILOT_ENABLED=false
SWITCH_DEFAULT_BROKERAGE_BPS=
SWITCH_DEFAULT_SHARE_BPS=
# Exemplo matemático: 500 bps de corretagem = 5% da venda;
# 3000 bps de participação M Switch = 30% dessa corretagem.

# Canal exclusivo M Switch; não herda as credenciais do atendimento principal.
# Número provisório informado pelo responsável em 29/10/2026.
SWITCH_WHATSAPP_EXPECTED_NUMBER=5585994488338
SWITCH_WHATSAPP_ACCESS_TOKEN=
SWITCH_WHATSAPP_PHONE_NUMBER_ID=
SWITCH_WHATSAPP_BUSINESS_ACCOUNT_ID=
SWITCH_WHATSAPP_GRAPH_VERSION=
SWITCH_META_APP_SECRET=
SWITCH_WHATSAPP_VERIFY_TOKEN=
SWITCH_WHATSAPP_WEBHOOK_ENABLED=false
# Retorno na Meta: https://www.emeselect.com/api/webhooks/switch-whatsapp
