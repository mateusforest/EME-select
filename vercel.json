{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/webhooks/switch-whatsapp",
      "destination": "/api/switchWhatsappWebhook"
    },
    {
      "source": "/inovacao",
      "destination": "/index.html"
    },
    {
      "source": "/inovacao/",
      "destination": "/index.html"
    },
    {
      "source": "/switch/sair/:token",
      "destination": "/index.html"
    },
    {
      "source": "/switch/profissionais",
      "destination": "/index.html"
    },
    {
      "source": "/switch/convite/:token",
      "destination": "/index.html"
    },
    {
      "source": "/switch",
      "destination": "/index.html"
    },
    {
      "source": "/switch/",
      "destination": "/index.html"
    },
    {
      "source": "/acesso-select/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/imovel/:id/capa.jpg",
      "destination": "/api/propertyShare?id=:id&cover=1"
    },
    {
      "source": "/imovel/:id",
      "destination": "/api/propertyShare?id=:id"
    },
    {
      "source": "/apresentar/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/api/webhooks/whatsapp",
      "destination": "/api/whatsappWebhook"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/portal?route=:path*"
    },
    {
      "source": "/enviar-imovel",
      "destination": "/index.html"
    },
    {
      "source": "/enviar-imovel/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/portal.js": {
      "maxDuration": 120
    },
    "api/whatsappWebhook.js": {
      "maxDuration": 30
    },
    "api/switchWhatsappWebhook.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/portalselect",
      "destination": "/acesso-select",
      "permanent": true
    },
    {
      "source": "/portalselect/demo/:path*",
      "destination": "/acesso-select/equipe/:path*",
      "permanent": true
    },
    {
      "source": "/portalselect/:path*",
      "destination": "/acesso-select/equipe/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/switch/cron",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/switch/convite/:token",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/switch/sair/:token",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
