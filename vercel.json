{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/portal?route=:path*"
    },
    {
      "source": "/enviar-imovel",
      "destination": "/index.html"
    },
    {
      "source": "/enviar-imovel/",
      "destination": "/index.html"
    },
    {
      "source": "/portalselect",
      "destination": "/index.html"
    },
    {
      "source": "/portalselect/:path*",
      "destination": "/index.html"
    }
  ]
}
