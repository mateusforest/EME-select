{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/portalselect", "destination": "/index.html" },
    { "source": "/portalselect/:path*", "destination": "/index.html" }
  ]
}
